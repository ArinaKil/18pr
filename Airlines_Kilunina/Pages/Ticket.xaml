<Page x:Class="Airlines_Kilunina.Pages.Ticket"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Airlines_Kilunina.Pages"
      xmlns:elements="clr-namespace:Airlines_Kilunina.Elements"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Ticket">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#1565C0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Images/plane.png" Height="40" Width="40" Margin="10,0,8,0"/>
                <TextBlock Text="Управление авиалиниями" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Content="Выход" HorizontalAlignment="Right" VerticalAlignment="Center"
                Background="White" Foreground="#1565C0" FontSize="13" FontWeight="SemiBold"
                Padding="16,6" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand"/>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible">
            <StackPanel x:Name="spItems" Margin="8"/>
        </ScrollViewer>
    </Grid>
</Page>
