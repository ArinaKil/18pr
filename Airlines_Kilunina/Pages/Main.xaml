<Page x:Class="Airlines_Kilunina.Pages.Main"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Airlines_Kilunina.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Main">

    <Grid Background="#1565C0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#1565C0" Margin="16,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Images/plane.png" Height="40" Width="40" Margin="0,0,8,0"/>
                <TextBlock Text="Управление авиалиниями" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Content="Выход" Click="Exit" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="White" Foreground="#1565C0" FontSize="13" FontWeight="SemiBold"
                    Padding="16,6" BorderThickness="0" Cursor="Hand"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Поиск дешёвых авиабилетов" Foreground="White"
                       FontSize="22" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,6"/>
            <TextBlock Text="Лучший способ купить авиабилеты дёшево" Foreground="#BBDEFB"
                       FontSize="13" TextAlignment="Center" Margin="0,0,0,24"/>

            <TextBlock Text="Откуда:" Foreground="White" FontSize="13" Margin="0,0,0,4"/>
            <TextBox x:Name="from" Height="32" Padding="8,4" FontSize="13" BorderThickness="0" Margin="0,0,0,14"/>

            <TextBlock Text="Куда:" Foreground="White" FontSize="13" Margin="0,0,0,4"/>
            <TextBox x:Name="to" Height="32" Padding="8,4" FontSize="13" BorderThickness="0" Margin="0,0,0,20"/>

            <Button Content="Найти" Click="Search" HorizontalAlignment="Right"
                    Background="#F44336" Foreground="White" FontSize="14" FontWeight="SemiBold"
                    Padding="24,8" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
        </Grid>
    </Grid>
</Page>
